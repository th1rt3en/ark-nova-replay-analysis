{
    "manifest_version": 3,
    "name": "Ark Nova Replay for BGA",
    "version": "1.3.0",
    "description": "Opens a BGA table in the Ark Nova replay: collects its log, table info and base projects.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": ["storage", "unlimitedStorage"],
    "host_permissions": ["https://boardgamearena.com/*"],
    "content_scripts": [
        {
            "matches": ["https://boardgamearena.com/*"],
            "js": ["capture.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://boardgamearena.com/*"],
            "js": ["button.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "nghoang190711@gmail.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["websiteContent"]
            }
        }
    }
}
