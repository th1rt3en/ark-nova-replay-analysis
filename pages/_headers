# Pictures and sounds: 30 days in the browser, a week stale-while-revalidate in the CDN.
# Art is rarely edited; when a picture changes, give the file a new name (or wait out the month).
# The index .json files inside the picture folders are not listed here on purpose: they keep the default (always revalidated).
/cards/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/cards_large/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/action_cards/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
